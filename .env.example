# Desarrollo local. En Vercel, configurar esta variable en el proyecto
# con la URL HTTPS de Render seguida de /api/v1/admin, sin barra final.
# Ejemplo de formato: https://TU-SERVICIO.onrender.com/api/v1/admin
VITE_API_BASE_URL=http://localhost:8000/api/v1/admin

# Las variables VITE_* son públicas: nunca colocar secretos del backend aquí.
